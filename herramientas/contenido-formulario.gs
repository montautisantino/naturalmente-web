  f.setCollectEmail(false);f.setShowLinkToRespondAgain(true);f.setConfirmationMessage('¡Listo! En unos minutos aparece en la web. Podés cargar otro con el link de abajo.');
  var tipo=f.addMultipleChoiceItem().setTitle(T.tipo).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.pub).setHelpText('Elegí "No" para dejarlo como borrador.').setChoiceValues(['Sí','No']).setRequired(true);
