  function par(k,req,help){var i=f.addParagraphTextItem().setTitle(T[k]).setRequired(!!req);if(help)i.setHelpText(help);return i}
  var pD=sec('¿Sabías que…?');par('d',1,'Un dato curioso, corto. Ej: "El maní no es un fruto seco: es una legumbre."');
  var pM=sec('¿Mito o realidad?');txt('mf',1,'La frase a adivinar. Ej: "El jengibre es una raíz."');f.addMultipleChoiceItem().setTitle(T.mr).setChoiceValues(['Mito','Realidad']).setRequired(true);par('me',1,'La explicación corta.');
  var pY=sec('Adiviná el yuyo');par('yp',1,'La pista, sin decir el nombre.');txt('yr',1);txt('y1',1);txt('y2',1);
  var pF=sec('Ficha de planta');txt('fp',1);txt('fs',0,'Ej: Matricaria chamomilla');txt('fu',1,'Ej: Flores, hojas, rizoma');txt('fc',1,'Ej: Infusión, decocción');txt('fa',1,'Ej: Suave y dulzón');par('fx',1,'Una curiosidad (no beneficios para la salud).');
  var pT=sec('Tip de alacena');txt('tt',1,'Ej: Frutos secos');par('tx',1);
  var pV=sec('Video');txt('vl',1,'El link del video de YouTube');txt('vt',1);f.addListItem().setTitle(T.vp).setChoiceValues(PROGRAMAS).setRequired(true);txt('vk',0,'Ej: Receta, Entrevista, Vivo');txt('vd',0,'Ej: 4 min');par('vx',1,'De qué trata. Podés separar en párrafos.');txt('vg',0,'Separados por coma. Ej: Digestión, Tisana');par('vm',0,'Uno por línea. Ej: 0:45 Cómo prepararla');par('vr',0,'Links de productos de la tienda que se mencionan, uno por línea.');
  var pN=sec('Nota');txt('nt',1);txt('nc',1,'Ej: Fitoterapia, Alimentación, Descanso');par('nb',1,'Una o dos líneas que resuman la nota.');par('nx',1,'El texto completo. Dejá una línea en blanco entre párrafos. Para un subtítulo, empezá la línea con ##');txt('ni',0,'Opcional: link de una imagen ya publicada (por ejemplo de Tiendanube). Si no ponés, usa una ilustración.');
  [pD,pM,pY,pF,pT,pV,pN].forEach(function(p,i,a){p.setGoToPage(FormApp.PageNavigationType.SUBMIT)});
  tipo.setChoices([tipo.createChoice('Dato (¿Sabías que…?)',pD),tipo.createChoice('Mito o realidad',pM),tipo.createChoice('Adiviná el yuyo',pY),tipo.createChoice('Ficha de planta',pF),tipo.createChoice('Tip',pT),tipo.createChoice('Video',pV),tipo.createChoice('Nota',pN)]);
  var ss=SpreadsheetApp.create('Dietéticas Naturalmente · Contenido de la web');
  f.setDestination(FormApp.DestinationType.SPREADSHEET,ss.getId());
  SpreadsheetApp.flush();Utilities.sleep(3000);
  var shs=ss.getSheets(),resp=null,base=null;shs.forEach(function(sh){if(sh.getFormUrl&&sh.getFormUrl())resp=sh;else if(!base)base=sh});if(!base)base=ss.insertSheet('Base');base.setName('Base');if(resp)resp.setName('Respuestas');
  var H=ORDEN.map(function(k){return T[k]});base.getRange(1,1,1,H.length).setValues([H]).setFontWeight('bold').setBackground('#1d4a2a').setFontColor('#ffffff');
  var rows=BASE.map(function(r){return ORDEN.map(function(k){return k==='tipo'?r.Tipo:k==='pub'?'Sí':(r[k]||'')})});
  if(rows.length)base.getRange(2,1,rows.length,H.length).setValues(rows);base.setFrozenRows(1);base.autoResizeColumns(1,3);
  DriveApp.getFileById(ss.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);
  var info={planilla:ss.getUrl(),planillaId:ss.getId(),formularioEditar:f.getEditUrl(),formularioCargar:f.getPublishedUrl()};
